{
  "_comment": "Void-Builder Preset: System Rescue, Forensics & Disk Partitioning",
  "preset_name": "rescue-sysadmin",
  "desktop": "xfce",
  "kernel": "linux",
  "bootloader": "grub",
  "boot_title": "Void Linux Rescue & SysAdmin",
  "customizations": {
    "hostname": "void-rescue",
    "copy_files": [
      {
        "source": "presets/rescue-sysadmin/autostart/create-rescue-icons.desktop",
        "destination": "/etc/xdg/autostart/create-rescue-icons.desktop"
      },
      {
        "source": "presets/rescue-sysadmin/scripts/add-rescue-desktop-icons.sh",
        "destination": "/usr/local/bin/add-rescue-desktop-icons.sh"
      }
    ]
  },
  "package_profiles": [
    "hardware",
    "filesystems",
    "networking",
    "dev-tools"
  ],
  "package_sources": {
    "official": [
      "gparted",
      "testdisk",
      "ddrescue",
      "smartmontools",
      "nvme-cli",
      "hdparm",
      "nmap",
      "tcpdump",
      "wireshark-qt",
      "iperf3",
      "rsync",
      "btrfs-progs",
      "xfsprogs",
      "f2fs-tools",
      "e2fsprogs",
      "dosfstools",
      "ntfs-3g",
      "cryptsetup",
      "lvm2",
      "mdadm",
      "chntpw",
      "memtest86+",
      "lsof",
      "strace",
      "inxi",
      "dmidecode",
      "bind-utils",
      "lshw",
      "net-tools",
      "traceroute"
    ]
  }
}

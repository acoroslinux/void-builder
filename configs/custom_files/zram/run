#!/bin/sh
set -eu

# Allocate half of available RAM as compressed swap. zramctl creates the
# device without reserving a fixed disk-backed swap partition.
mem_kib=$(awk '/MemTotal:/ {print $2; exit}' /proc/meminfo)
size_kib=$((mem_kib / 2))
[ "$size_kib" -gt 0 ] || exit 0

device=$(zramctl --find --size "${size_kib}K")
trap 'swapoff "$device" 2>/dev/null || true; zramctl --reset "$device" 2>/dev/null || true' EXIT INT TERM
mkswap -L zram "$device" >/dev/null
swapon --priority 100 "$device"

# Keep the runit service alive while the swap device is active.
exec pause

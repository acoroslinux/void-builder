UI vesamenu.c32
PROMPT 0
TIMEOUT 150
ONTIMEOUT linux

MENU TABMSG Press ENTER to boot or TAB to edit a menu entry
MENU AUTOBOOT BIOS default device boot in # second{,s}...
MENU TITLE @@BOOT_TITLE@@ @@DESKTOP@@ (@@ARCH@@)
MENU BACKGROUND @@SPLASHIMAGE@@
MENU RESOLUTION 640 480
MENU WIDTH 78
MENU MARGIN 1
MENU ROWS 12
MENU VSHIFT 2
MENU TIMEOUTROW 13
MENU TABMSGROW 2
MENU CMDLINEROW 16
MENU HELPMSGROW 20

MENU COLOR title        * #FF5255FF *
MENU COLOR border       * #00000000 #00000000 none
MENU COLOR sel          * #ffffffff #FF5255FF *

LABEL linux
  MENU LABEL @@BOOT_TITLE@@ @@DESKTOP@@ (Standard Live)
  KERNEL /boot/vmlinuz
  APPEND initrd=/boot/initrd root=live:CDLABEL=@@VOL_ID@@ ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=3 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ splash quiet rd.plymouth=1 vt.global_cursor_default=0 @@BOOT_CMDLINE@@ @@KERNEL_PARAMS@@

LABEL linuxram
  MENU LABEL @@BOOT_TITLE@@ @@DESKTOP@@ (Copy to RAM)
  KERNEL /boot/vmlinuz
  APPEND initrd=/boot/initrd root=live:CDLABEL=@@VOL_ID@@ ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=3 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ splash quiet rd.plymouth=1 vt.global_cursor_default=0 rd.live.ram @@BOOT_CMDLINE@@ @@KERNEL_PARAMS@@

LABEL linuxnogfx
  MENU LABEL @@BOOT_TITLE@@ @@DESKTOP@@ (Safe Graphics - nomodeset)
  KERNEL /boot/vmlinuz
  APPEND initrd=/boot/initrd root=live:CDLABEL=@@VOL_ID@@ ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=3 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ nomodeset @@BOOT_CMDLINE@@ @@KERNEL_PARAMS@@

LABEL linuxa11y
  MENU LABEL @@BOOT_TITLE@@ @@DESKTOP@@ with Speech (Accessibility)
  KERNEL /boot/vmlinuz
  APPEND initrd=/boot/initrd root=live:CDLABEL=@@VOL_ID@@ ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=3 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ splash quiet live.accessibility live.autologin @@BOOT_CMDLINE@@ @@KERNEL_PARAMS@@

LABEL c
  MENU LABEL Boot first HD found by BIOS
  COM32 chain.c32
  APPEND hd0

LABEL memtest
  MENU LABEL Run Memtest86+ (RAM test)
  LINUX /boot/memtest.bin

LABEL reboot
  MENU LABEL Reboot
  COM32 reboot.c32

LABEL poweroff
  MENU LABEL Power Off
  COM32 poweroff.c32

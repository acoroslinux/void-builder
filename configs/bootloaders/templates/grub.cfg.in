set default=0
set timeout=15
set timeout_style=menu

# Source graphical configuration, fonts and display settings
if [ -f /boot/grub/config.cfg ]; then
    source /boot/grub/config.cfg
fi

# Main Live Boot Entries for Void Linux
menuentry 'Start @@BOOT_TITLE@@ @@DESKTOP@@ (Live)' --class void --class gnu-linux --class os --hotkey=l {
    set gfxpayload="keep"
    search --no-floppy --set=root --label @@VOL_ID@@
    if [ -z "$root" ]; then
        search --no-floppy --set=root --file /boot/vmlinuz
    fi
    linux /boot/vmlinuz root=live:CDLABEL=@@VOL_ID@@ ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ @@BOOT_CMDLINE@@
    initrd /boot/initrd
}

menuentry 'Start @@BOOT_TITLE@@ @@DESKTOP@@ (Copy to RAM)' --class void --class gnu-linux --class os --hotkey=r {
    set gfxpayload="keep"
    search --no-floppy --set=root --label @@VOL_ID@@
    if [ -z "$root" ]; then
        search --no-floppy --set=root --file /boot/vmlinuz
    fi
    linux /boot/vmlinuz root=live:CDLABEL=@@VOL_ID@@ ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ rd.live.ram @@BOOT_CMDLINE@@
    initrd /boot/initrd
}

menuentry 'Start @@BOOT_TITLE@@ @@DESKTOP@@ (Safe Graphics - nomodeset)' --class void --class gnu-linux --class os --hotkey=f {
    set gfxpayload="keep"
    search --no-floppy --set=root --label @@VOL_ID@@
    if [ -z "$root" ]; then
        search --no-floppy --set=root --file /boot/vmlinuz
    fi
    linux /boot/vmlinuz root=live:CDLABEL=@@VOL_ID@@ ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ nomodeset @@BOOT_CMDLINE@@
    initrd /boot/initrd
}

menuentry 'Start @@BOOT_TITLE@@ @@DESKTOP@@ with Speech (Accessibility)' --class void --class gnu-linux --class os --hotkey=s {
    set gfxpayload="keep"
    search --no-floppy --set=root --label @@VOL_ID@@
    if [ -z "$root" ]; then
        search --no-floppy --set=root --file /boot/vmlinuz
    fi
    linux /boot/vmlinuz root=live:CDLABEL=@@VOL_ID@@ ro init=/sbin/init rd.luks=0 rd.md=0 rd.dm=0 loglevel=4 gpt add_efi_memmap vconsole.unicode=1 vconsole.keymap=@@KEYMAP@@ locale.LANG=@@LOCALE@@ live.accessibility live.autologin @@BOOT_CMDLINE@@
    initrd /boot/initrd
}

if [ "${grub_platform}" == 'efi' ]; then
    menuentry 'UEFI Firmware Settings' --id 'uefifw' {
        fwsetup
    }
fi

menuentry 'System restart' --class reboot --class restart {
    echo 'System rebooting...'
    reboot
}

menuentry 'System shutdown' --class shutdown --class poweroff {
    echo 'System shutting down...'
    halt
}
